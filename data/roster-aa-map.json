{
  "_comment": "Curated join map: our roster id -> the Artificial Analysis model it is calibrated on, pinned by AA UUID (`aaId`). The `slug` is a readable hint only — AA recycles bare slugs for newer checkpoints (deepseek-v4-flash, deepseek-v4-pro, hy3), so every build checks that the slug still names the pinned UUID (scripts/aa-cells.mjs pinProblem). Cells resolve reference snapshot -> latest snapshot (equated) -> bridge; see scripts/aa-cells.mjs. Refresh: `node scripts/aa-sync.mjs snapshot && node scripts/aa-sync.mjs bridges && node scripts/aa-sync.mjs build`; inspect with `node scripts/aa-sync.mjs report`.",
  "referenceSnapshot": "data/aa-reference-2026-06-21.json",
  "benchmarkCells": {
    "_comment": "BenchInputs field -> Artificial Analysis eval key: the six canonical cells calibrate.ts blends per axis, all on the REFERENCE scale (the 2026-06-21 snapshot the CURVES were fitted on). A cell AA re-scored is mapped back by same-UUID equating; a cell AA no longer publishes is bridged from measured cells (data/aa-bridges.json). `aa-sync.mjs build` emits them (×100, 0.1 rounding) into src/sim/roster.bench.generated.ts with per-cell provenance.",
    "gpqaDiamond": "gpqa",
    "ifBench": "ifbench",
    "lcr": "lcr",
    "sciCode": "scicode",
    "terminalBenchHard": "terminalbench_hard",
    "hle": "hle"
  },
  "successorCells": {
    "_comment": "Display-only successor evals (also bridge predictors): emitted next to the canonical cells, never blended.",
    "terminalBenchV21": "terminalbench_v2_1",
    "terminalBenchV40": "terminalbench_v4_0",
    "tauBanking": "tau_banking"
  },
  "axisBlends": {
    "_comment": "Documents the per-axis weighted blend (primary 0.6 + two secondary 0.2). The authoritative copy lives in calibrate.ts BLEND; this is for reference + the report/catalog commands.",
    "chat": "ifBench·0.6 + gpqaDiamond·0.2 + lcr·0.2",
    "general": "gpqaDiamond·0.6 + ifBench·0.2 + lcr·0.2",
    "coding": "sciCode·0.6 + terminalBenchHard·0.2 + ifBench·0.2",
    "reasoning": "hle·0.6 + gpqaDiamond·0.2 + lcr·0.2",
    "agentic": "terminalBenchHard·0.6 + ifBench·0.2 + lcr·0.2"
  },
